# %% functie voor bepalen uitkomstmaten

# wat erin moet:
# Y1 = Test data
# y_score = voorspelde kans : clf.predict_proba(X_test)[:, 1] (hierbij is X_test dus vd testdata)
# y_pred = = voorspelde klasse : clf.predict(X_test) (hierbij is X_test dus vd testdata)
# clf = classifier model

def outcomes(Y1, y_score, y_pred, clf):
    from sklearn import metrics

    auc=metrics.roc_auc_score(Y1, y_score)
    accuracy=metrics.accuracy_score(Y1, y_pred)
    F1=metrics.f1_score(Y1,y_pred)
    precision=metrics.precision_score(Y1,y_pred)
    recall=metrics.recall_score(Y1, y_pred)
# accuracy, AUC, f1score, precision, recall
    print(type(clf))
    print('Acc:' +str(accuracy))
    print('AUC:' +str(auc))
    print('F1:' +str(F1))
    print('precision:' +str(precision))
    print('recall:' +str(recall))

    return auc, accuracy, F1, precision, recall