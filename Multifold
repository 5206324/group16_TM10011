#%% importeren
import pandas as pd
import numpy as np
import os
import matplotlib.pyplot as plt

# Machine Learning & Evaluation
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import StandardScaler, RobustScaler
from sklearn.decomposition import PCA
from sklearn import metrics
from sklearn.impute import SimpleImputer

# Example model to demonstrate the training loop
from sklearn.ensemble import RandomForestClassifier 

#%% Load Data
path = (r"C:\Users\Mfvan\Dropbox\pc (4)\Documents\01 Melle van Hoffe\Klinische Technologie\TM 1, S&S\TM110011 Machine Learning\group16_TM10011\Lipo_radiomicFeatures.csv")

def load_data():
    this_directory = os.path.dirname(os.path.abspath(__file__))
    data = pd.read_csv(os.path.join(this_directory, 'Lipo_radiomicFeatures.csv'), index_col=0)

    return data


data = load_data()

#%% Prepare Data for Splitting
target_column = 'label' 

# Separate features (X) and target (y)
X = data.drop(columns=[target_column])
y = data[target_column]

#%% Stratified K-Fold Cross Validation Loop with integrated preprocessing
# Split into 5 folds
k_folds = 5
skf = StratifiedKFold(n_splits=k_folds, shuffle=True, random_state=42)

# Scaler and model
robust_scaler = RobustScaler()
imputer = SimpleImputer(strategy='median')
model = RandomForestClassifier(random_state=42) 

fold_accuracies = []

print(f"Starting {k_folds}-Fold Cross Validation...\n" + "-"*35)

for fold, (train_index, test_index) in enumerate(skf.split(X, y), 1):
    # Enumarate - zodat in de interactive window mee te tellen is
    # 1. Split the data 
    X_train, X_test = X.iloc[train_index], X.iloc[test_index]
    y_train, y_test = y.iloc[train_index], y.iloc[test_index]
    
    # 2. VANG NaN WAARDEN OP (Imputation)
    # Fit de imputer ALLEEN op de training data om data leakage te voorkomen
    X_train_imputed = imputer.fit_transform(X_train)
    X_test_imputed = imputer.transform(X_test)

    # 3. Scale the data
    # VERY IMPORTANT: Fit the scaler ONLY on the training data to prevent "data leakage", 
    # then transform both the training and test data.
    X_train_scaled = robust_scaler.fit_transform(X_train_imputed)
    X_test_scaled = robust_scaler.transform(X_test_imputed)
    
    # 4. Train the model
    model.fit(X_train_scaled, y_train)
    
    # 5. Make predictions on the test fold
    y_pred = model.predict(X_test_scaled)
    y_score = model.predict_proba(X_test_scaled)[:, 1]

    
    # 6. Evaluate and store the metric
    accuracy = metrics.accuracy_score(y_test, y_pred)
    fold_accuracies.append(accuracy)
    
    print(f"Fold {fold} Accuracy: {accuracy:.4f}")

print("-" * 35)
print(f"Average Accuracy: {np.mean(fold_accuracies):.4f} (± {np.std(fold_accuracies):.4f})")
